 {
  "title": "File:Inland Pack Track MRD 10.jpg",
  "width": 3024,
  "height": 4032,
  "mime": "image/jpeg",
  "url": "https://upload.wikimedia.org/wikipedia/commons/f/f2/Inland_Pack_Track_MRD_10.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original",
  "thumb": "https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f2/Inland_Pack_Track_MRD_10.jpg/960px-Inland_Pack_Track_MRD_10.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail",
